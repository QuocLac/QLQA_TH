@model IEnumerable<QLQA_TH.Models.HoaDon>

@{
    ViewData["Title"] = "Thu Ngân - Hóa Đơn";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Dùng layout chung của nhân viên
}

<!-- Sử dụng lại CSS bảng đẹp -->
<link href="~/css/tableStyle.css" rel="stylesheet" />

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-success">
            Quản Lý Thu Ngân
        </h2>
    </div>

    <!-- THANH CÔNG CỤ & BỘ LỌC -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <!-- Form lọc dữ liệu (GET) -->
            <form method="get" class="d-flex flex-wrap align-items-center gap-3 justify-content-between">

                <!-- 1. Bộ lọc Trạng thái (Combobox) -->
                <div class="d-flex align-items-center gap-2">
                    <label class="fw-bold text-muted small mb-0"><i class="fa-solid fa-filter me-1"></i>Trạng thái:</label>
                    <select name="status" class="form-select w-auto fw-bold text-dark border-success" onchange="this.form.submit()" style="min-width: 180px;">
                        <!option value="0" @(ViewBag.CurrentStatus == 0 ? "selected" : "")>Chờ thanh toán</!option>
                        <!option value="1" @(ViewBag.CurrentStatus == 1 ? "selected" : "")>Đã thanh toán</!option>
                        <!option value="3" @(ViewBag.CurrentStatus == 3 ? "selected" : "")>Đã hủy</!option>
                    </select>
                </div>

                <div class="vr h-100 mx-2 d-none d-md-block text-muted"></div>

                <!-- 2. Bộ lọc Ngày (Từ ngày - Đến ngày) -->
                <div class="d-flex align-items-center gap-2">
                    <div class="input-group w-auto">
                        <span class="input-group-text bg-light small text-muted border-end-0"><i class="fa-regular fa-calendar"></i></span>
                        <input type="date" name="fromDate" value="@ViewData["FromDate"]" class="form-control border-start-0 ps-0" onchange="this.form.submit()" />
                    </div>
                    <span class="text-muted">-</span>
                    <div class="input-group w-auto">
                        <span class="input-group-text bg-light small text-muted border-end-0"><i class="fa-regular fa-calendar"></i></span>
                        <input type="date" name="toDate" value="@ViewData["ToDate"]" class="form-control border-start-0 ps-0" onchange="this.form.submit()" />
                    </div>
                </div>

                <!-- Nút Đặt lại (Reset) -->
                @if (ViewData["FromDate"] != null || ViewData["ToDate"] != null || ViewBag.CurrentStatus != 0)
                {
                    <a asp-action="Index" class="btn btn-light text-danger border-danger btn-sm fw-bold d-flex align-items-center gap-1 hover-danger">
                        <i class="fa-solid fa-rotate-left"></i> Đặt lại
                    </a>
                }
            </form>
        </div>
    </div>

    <!-- BẢNG DỮ LIỆU HÓA ĐƠN -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <table class="rounded-table">
                <thead>
                    <tr>
                        <th class="ps-4 text-start">Mã HĐ</th>
                        <th>Bàn</th>
                        <th>Thời gian vào</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        // Logic màu sắc trạng thái
                        string badgeClass = "";
                        string statusText = "";

                        if (item.TrangThaiHoaDon == 0)
                        {
                            badgeClass = "bg-warning text-dark border border-warning";
                            statusText = "Chờ thanh toán";
                        }
                        else if (item.TrangThaiHoaDon == 1)
                        {
                            badgeClass = "bg-success bg-opacity-10 text-success border border-success";
                            statusText = "Hoàn tất";
                        }
                        else if (item.TrangThaiHoaDon == 3)
                        {
                            badgeClass = "bg-danger bg-opacity-10 text-danger border border-danger";
                            statusText = "Đã hủy";
                        }

                        <tr>
                            <td class="ps-4 text-start fw-bold text-secondary">#@item.MaHD</td>
                            <td class="fw-bold text-dark fs-5">@item.Ban?.TenBan</td>
                            <td>
                                <div class="d-flex flex-column">
                                    <span class="fw-bold">@item.ThoiGianVao.ToString("HH:mm")</span>
                                    <span class="small text-muted">@item.ThoiGianVao.ToString("dd/MM/yyyy")</span>
                                </div>
                            </td>
                            <td class="fw-bold text-danger fs-5">@item.ThanhTien.ToString("N0") ₫</td>
                            <td>
                                <span class="badge @badgeClass rounded-pill px-3 py-2">@statusText</span>
                            </td>
                            <td>
                                @if (item.TrangThaiHoaDon == 0)
                                {
                                    <a asp-action="Checkout" asp-route-id="@item.MaHD" class="btn btn-success btn-sm fw-bold px-3 shadow-sm rounded-pill">
                                        <i class="fa-solid fa-money-bill-wave me-1"></i> Thu tiền
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="Checkout" asp-route-id="@item.MaHD" class="btn btn-light btn-sm text-primary border rounded-pill px-3" title="Xem lại chi tiết">
                                        <i class="fa-solid fa-file-invoice"></i> Xem lại
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <img src="/images/empty-box.png" style="width: 60px; opacity: 0.3; margin-bottom: 15px;" onerror="this.style.display='none'" />
                    <p class="text-muted mb-0">Không tìm thấy hóa đơn nào phù hợp.</p>
                </div>
            }
        </div>
    </div>
</div>