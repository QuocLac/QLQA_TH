@model QLQA_TH.Models.PhieuDat

<div class="p-3">
    <!-- 1. HEADER PHIẾU -->
    <div class="d-flex justify-content-between align-items-start mb-3 pb-3 border-bottom">
        <div>
            <h5 class="fw-bold text-dark mb-1">Phiếu #@Model.MaPhieu</h5>
            <div class="text-muted small">
                <i class="fa-regular fa-clock me-1"></i> @Model.ThoiGianDat.ToString("HH:mm - dd/MM/yyyy")
            </div>
        </div>
        <div class="text-end">
            <div class="fw-bold text-success fs-5">
                @(Model.HoaDon?.Ban?.TenBan ?? "Mang về")
            </div>
            <!-- Badge Trạng thái -->
            @if (Model.TrangThai == 2)
            {
                <span class="badge bg-success bg-opacity-10 text-success border border-success">Hoàn tất</span>
            }
            else if (Model.TrangThai == 4)
            {
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary">Đã phục vụ</span>
            }
            else
            {
                <span class="badge bg-secondary">Lưu trữ</span>
            }
        </div>
    </div>

    <!-- 2. CHI TIẾT MÓN ĂN (Giao diện Bếp tập trung vào SL và Tên) -->
    <div class="bg-light rounded-3 p-3">
        <h6 class="text-muted text-uppercase small fw-bold mb-3">Danh sách món đã làm</h6>

        @foreach (var item in Model.DonHangs)
        {
            <div class="d-flex align-items-center mb-2 pb-2 border-bottom border-white">
                <!-- Số lượng nổi bật -->
                <div class="badge bg-dark text-white fs-6 me-3" style="min-width: 40px;">
                    @item.SoLuong
                </div>

                <!-- Tên món -->
                <div class="flex-grow-1">
                    <div class="fw-bold text-dark">@item.MonAn.TenMon</div>
                    <!-- Nếu có ghi chú món ăn thì hiện ở đây (Optional) -->
                    @* <small class="text-danger fst-italic">@item.GhiChu</small> *@
                </div>
            </div>
        }
    </div>

    <!-- 3. FOOTER (Thông tin người thực hiện) -->
    <div class="mt-3 pt-2 text-end small text-muted">
        <div>Người gọi: <strong>@(Model.NhanVienDat?.HoTen ?? "---")</strong></div>
        <div>Đầu bếp: <strong class="text-dark">@(Model.NhanVienBep?.HoTen ?? "---")</strong></div>
    </div>

    <div class="text-center mt-4">
        <button type="button" class="btn btn-secondary w-100" data-bs-dismiss="modal">Đóng</button>
    </div>
</div>