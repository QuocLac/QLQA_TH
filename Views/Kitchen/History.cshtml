@model List<QLQA_TH.Models.PhieuDat>

@{
    ViewData["Title"] = "Lịch Sử Chế Biến";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/css/tableStyle.css" rel="stylesheet" />
<link href="~/css/searchBarStyle.css" rel="stylesheet" />

<div class="container py-4">
    <div class="my-4">
        <h2 class="fw-bold text-dark">Lịch Sử Chế Biến</h2>
        <p class="text-muted mb-0">Danh sách các phiếu bạn (@User.Identity?.Name) đã hoàn thành.</p>
    </div>

    <!-- BỘ LỌC -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form asp-action="History" method="get" class="d-flex flex-wrap align-items-center gap-3">

                <select name="status" class="form-select w-auto" onchange="this.form.submit()">
                    @foreach (var item in (List<SelectListItem>)ViewBag.StatusList)
                    {
                        bool isSelected = ViewData["CurrentStatus"]?.ToString() == item.Value;
                        <option value="@item.Value" selected="@isSelected">@item.Text</option>
                    }
                </select>

                <div class="input-group w-auto">
                    <span class="input-group-text small bg-white text-muted">Từ:</span>
                    <input type="date" name="fromDate" value="@ViewData["FromDate"]" class="form-control" onchange="this.form.submit()" />
                </div>

                <div class="input-group w-auto">
                    <span class="input-group-text small bg-white text-muted">Đến:</span>
                    <input type="date" name="toDate" value="@ViewData["ToDate"]" class="form-control" onchange="this.form.submit()" />
                </div>

                @if (ViewData["CurrentStatus"] != null || ViewData["FromDate"] != null || ViewData["ToDate"] != null)
                {
                    <a asp-action="History" class="btn btn-outline-danger btn-sm">
                        <i class="fa-solid fa-xmark"></i> Reset
                    </a>
                }
            </form>
        </div>
    </div>

    <!-- BẢNG DỮ LIỆU -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <table class="rounded-table">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 10%;">Mã Phiếu</th>
                        <th style="width: 20%;">Thời gian nhận</th>
                        <th style="width: 20%;">Bàn phục vụ</th>
                        <th class="text-center" style="width: 20%;">Trạng thái</th>
                        <th class="text-center" style="width: 15%;">Xem lại</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        string statusText = "";
                        string statusClass = "";

                        if (item.TrangThai == 2)
                        {
                            statusText = "Đã hoàn tất";
                            statusClass = "bg-success bg-opacity-10 text-success";
                        }
                        else if (item.TrangThai == 4)
                        {
                            statusText = "Đã phục vụ";
                            statusClass = "bg-primary bg-opacity-10 text-primary";
                        }
                        else
                        {
                            statusText = "Khác";
                            statusClass = "bg-secondary text-white";
                        }

                        <tr>
                            <td class="text-center fw-bold text-muted">#@item.MaPhieu</td>
                            <td>
                                <i class="fa-regular fa-clock me-1 text-muted"></i>
                                @item.ThoiGianDat.ToString("HH:mm - dd/MM/yyyy")
                            </td>
                            <td class="fw-bold text-dark">
                                @(item.HoaDon?.Ban?.TenBan ?? "Mang về")
                            </td>
                            <td class="text-center">
                                <span class="badge @statusClass rounded-pill px-3 py-2 border">@statusText</span>
                            </td>
                            <td class="text-center">
                                <button onclick="showDetail(@item.MaPhieu)" class="btn btn-sm btn-light text-primary border rounded-circle" title="Xem chi tiết món" style="width: 35px; height: 35px;">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="fa-solid fa-fire-burner fs-1 text-muted mb-3" style="opacity: 0.3;"></i>
                    <p class="text-muted">Bạn chưa có lịch sử chế biến nào trong khoảng thời gian này.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Container (Giống bên Order) -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-success text-white rounded-top-4">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-receipt me-2"></i>Chi Tiết Phiếu Đặt</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0" id="modalDetailBody">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        function showDetail(maPhieu) {
            var myModal = new bootstrap.Modal(document.getElementById('detailModal'));
            myModal.show();

            $.ajax({
                url: '/Kitchen/GetOrderDetails',
                type: 'GET',
                data: { maPhieu: maPhieu },
                success: function (res) {
                    $('#modalDetailBody').html(res);
                },
                error: function () {
                    $('#modalDetailBody').html('<p class="text-danger text-center py-4">Lỗi tải dữ liệu!</p>');
                }
            });
        }
    </script>
}