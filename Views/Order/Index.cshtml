@model IEnumerable<QLQA_TH.Models.Ban>

@{
    ViewData["Title"] = "Chọn Bàn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Link CSS -->
<link href="~/css/searchBarStyle.css" rel="stylesheet" />
<link href="~/css/orderStyle.css" rel="stylesheet" />

<div class="container py-4">
    <!-- 1. TIÊU ĐỀ & TÌM KIẾM -->
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h2 class="fw-bold text-success mb-0">Đặt Món Tại Bàn
            </h2>
            <p class="text-muted">Chọn một bàn để bắt đầu gọi món hoặc thanh toán.</p>
        </div>
        <div class="col-md-6">
            <form asp-action="Index" method="get">
                <div class="custom-search-bar shadow-sm">
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Tìm kiếm bàn nhanh..." />
                    <button type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
                </div>
            </form>
        </div>
    </div>

    <!-- 2. TABS CHUYỂN ĐỔI TRẠNG THÁI -->
    <ul class="nav nav-pills mb-4" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="pills-free-tab" data-bs-toggle="pill" data-bs-target="#pills-free" type="button" role="tab">
                <i class="fa-solid fa-check me-2"></i>Còn Trống
                <span class="badge bg-white text-success ms-1">@Model.Count(b => b.TrangThai == 0)</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="pills-occupied-tab" data-bs-toggle="pill" data-bs-target="#pills-occupied" type="button" role="tab">
                <i class="fa-solid fa-users me-2"></i>Đang Sử Dụng
                <span class="badge bg-white text-success ms-1">@Model.Count(b => b.TrangThai == 1 || b.TrangThai == 2)</span>
            </button>
        </li>
    </ul>

    <!-- 3. NỘI DUNG TAB -->
    <div class="tab-content" id="pills-tabContent">
        <!-- TAB 1: BÀN TRỐNG -->
        <div class="tab-pane fade show active" id="pills-free" role="tabpanel">
            <div class="table-grid">
                @foreach (var item in Model.Where(b => b.TrangThai == 0))
                {
                    <a asp-action="Detail" asp-route-tableId="@item.MaBan" class="table-card status-free">
                        <div class="table-header">
                            <i class="fa-solid fa-chair table-icon"></i>
                            <h5 class="table-name">@item.TenBan</h5>
                        </div>
                        <div class="table-body">
                            <i class="fa-solid fa-user-group me-1"></i> @item.SoGhe ghế
                        </div>
                    </a>
                }
                @if (!Model.Any(b => b.TrangThai == 0))
                {
                    <div class="text-center text-muted py-5 w-100">Không có bàn nào đang trống.</div>
                }
            </div>
        </div>

        <!-- TAB 2: ĐANG SỬ DỤNG -->
        <div class="tab-pane fade" id="pills-occupied" role="tabpanel">
            <div class="table-grid">
                @foreach (var item in Model.Where(b => b.TrangThai != 0))
                {
                    string statusClass = item.TrangThai == 1 ? "status-occupied" : "status-booked";
                    string icon = item.TrangThai == 1 ? "fa-utensils" : "fa-clock";
                    string textStatus = item.TrangThai == 1 ? "Đang ăn" : "Đã đặt";

                    <a asp-action="Detail" asp-route-tableId="@item.MaBan" class="table-card @statusClass">
                        <div class="table-header">
                            <i class="fa-solid @icon table-icon"></i>
                            <h5 class="table-name">@item.TenBan</h5>
                        </div>
                        <div class="table-body d-flex justify-content-between px-3">
                            <span><i class="fa-solid fa-user-group"></i> @item.SoGhe ghế</span>
                            <span class="fw-bold">@textStatus</span>
                        </div>
                    </a>
                }
                @if (!Model.Any(b => b.TrangThai != 0))
                {
                    <div class="text-center text-muted py-5 w-100">Chưa có bàn nào đang phục vụ.</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- 4. CONTAINER THÔNG BÁO (TOAST STACK) -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" id="notificationArea"></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        var displayedTickets = [];
        setInterval(checkNotifications, 5000);

        function checkNotifications() {
            $.ajax({
                url: '/Order/GetReadyNotifications',
                type: 'GET',
                success: function (data) {
                    if (data && data.length > 0) {
                        data.forEach(function (item) {
                            if (!displayedTickets.includes(item.maPhieu)) {
                                showToast(item);
                                displayedTickets.push(item.maPhieu);
                            }
                        });
                    }
                }
            });
        }

        // Hàm hiển thị Toast với nút "Đã bưng"
        function showToast(data) {
            var toastId = 'toast-' + data.maPhieu;
            var toastHtml = `
                <div id="${toastId}" class="toast custom-toast show" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="custom-toast-header">
                        <strong class="toast-title">
                            <i class="fa-solid fa-bell fa-shake"></i> BẾP XONG - ${data.tenBan}
                        </strong>
                        <small class="toast-time">${data.thoiGian}</small>
                        <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                    <div class="custom-toast-body">
                        <div class="fw-bold text-dark mb-1">Phiếu #${data.maPhieu}</div>
                        <div class="mb-2">${data.monAnSummary}</div>

                        <div class="d-flex justify-content-end gap-2">
                             <!-- NÚT XÁC NHẬN NHANH -->
                             <button onclick="quickConfirmServed(${data.maPhieu}, '${toastId}')" class="btn btn-sm btn-success fw-bold shadow-sm" style="font-size: 0.85rem;">
                                <i class="fa-solid fa-check me-1"></i> Đã bưng
                             </button>
                        </div>
                    </div>
                </div>
            `;
            $('#notificationArea').append(toastHtml);
        }

        // Hàm xử lý sự kiện click "Đã bưng"
        function quickConfirmServed(maPhieu, toastElementId) {
            $.ajax({
                url: '/Order/ConfirmServed',
                type: 'POST',
                data: { maPhieu: maPhieu },
                success: function (res) {
                    if (res.success) {
                        // 1. Ẩn Toast ngay lập tức
                        $('#' + toastElementId).removeClass('show').addClass('hide');
                        setTimeout(() => { $('#' + toastElementId).remove(); }, 500);

                        // 2. Hiển thị thông báo nhỏ (Toast Alert)
                        const Toast = Swal.mixin({
                          toast: true, position: 'top-end', showConfirmButton: false, timer: 2000,
                          timerProgressBar: true,
                          didOpen: (toast) => {
                            toast.addEventListener('mouseenter', Swal.stopTimer)
                            toast.addEventListener('mouseleave', Swal.resumeTimer)
                          }
                        })
                        Toast.fire({ icon: 'success', title: 'Đã phục vụ món cho khách!' })

                    } else {
                        Swal.fire('Lỗi', res.msg, 'error');
                    }
                }
            });
        }
    </script>
}