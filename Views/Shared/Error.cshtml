@model Models.ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
    Layout = null; /* Trang lỗi đứng độc lập, không dùng Layout chung để tránh lỗi chồng chéo */
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đã có lỗi xảy ra - QLQA</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        :root {
            --primary-green: #2E7D32;
            --light-green: #E8F5E9;
            --text-color: #333;
        }

        body {
            background-color: var(--light-green);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: var(--text-color);
            overflow: hidden;
        }

        .error-card {
            background: white;
            padding: 3rem;
            border-radius: 24px;
            box-shadow: 0 15px 30px rgba(46, 125, 50, 0.1);
            text-align: center;
            max-width: 500px;
            width: 90%;
            position: relative;
            animation: slideUp 0.6s ease-out;
        }

        /* Icon hoạt hình */
        .error-icon-wrapper {
            width: 120px;
            height: 120px;
            background-color: #F1F8E9;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 2rem auto;
            position: relative;
        }

        .error-icon {
            font-size: 4rem;
            color: var(--primary-green);
            animation: heartbeat 2s infinite;
        }

        h1 {
            font-weight: 800;
            color: var(--primary-green);
            margin-bottom: 1rem;
        }

        p.lead {
            color: #666;
            font-size: 1.1rem;
            margin-bottom: 2rem;
        }

        .btn-home {
            background-color: var(--primary-green);
            color: white;
            padding: 12px 35px;
            border-radius: 50px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s;
            box-shadow: 0 5px 15px rgba(46, 125, 50, 0.3);
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

            .btn-home:hover {
                background-color: #1B5E20;
                color: white;
                transform: translateY(-3px);
                box-shadow: 0 8px 20px rgba(46, 125, 50, 0.4);
            }

        .request-id {
            margin-top: 2rem;
            font-size: 0.85rem;
            color: #999;
            background: #fafafa;
            padding: 8px;
            border-radius: 8px;
            display: inline-block;
        }

        /* --- ANIMATIONS --- */
        keyframes slideUp {
            from

        {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        keyframes heartbeat {
            0%

        {
            transform: scale(1);
        }

        10% {
            transform: scale(1.1);
        }

        20% {
            transform: scale(1);
        }

        30% {
            transform: scale(1.1);
        }

        40% {
            transform: scale(1);
        }

        100% {
            transform: scale(1);
        }

        }
    </style>
</head>
<body>

    <div class="error-card">
        <!-- Hình động -->
        <div class="error-icon-wrapper">
            <i class="fa-solid fa-robot error-icon"></i>
        </div>

        <h1>Úi chà! Lỗi rồi.</h1>
        <p class="lead">
            Hệ thống đang gặp chút trục trặc hoặc trang bạn tìm không tồn tại. Đừng lo, chúng tôi đang kiểm tra.
        </p>

        <a href="/" class="btn-home">
            <i class="fa-solid fa-house"></i> Quay về trang chủ
        </a>

        @if (Model.ShowRequestId)
        {
            <div class="request-id">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </div>
        }
    </div>

</body>
</html>