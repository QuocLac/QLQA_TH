@model QLQA_TH.Areas.Admin.Models.UserUpsertViewModel

@{
    ViewData["Title"] = (Model.MaNV != 0 ? "Cập nhật" : "Thêm mới") + " Nhân Viên";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center my-4">
        <div>
            <h2 class="fw-bold text-success">@ViewData["Title"]</h2>
            <p class="text-muted mb-0">Quản lý hồ sơ và tài khoản truy cập.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-2"></i> Quay lại</a>
    </div>

    <form asp-action="Upsert" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="MaNV" />
        <input type="hidden" asp-for="HinhAnh" />
        <input type="hidden" asp-for="HasAccount" />
        <input type="hidden" asp-for="Id_TK" />

        <div class="row">
            <!-- CỘT TRÁI: THÔNG TIN NHÂN VIÊN -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="fw-bold text-success mb-0"><i class="fa-solid fa-id-card me-2"></i>Thông tin cá nhân</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="HoTen" class="form-label fw-bold">Họ và Tên</label>
                                <input asp-for="HoTen" class="form-control" placeholder="Nhập họ tên..." />
                                <span asp-validation-for="HoTen" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ChucVu" class="form-label fw-bold">Chức vụ</label>
                                <input asp-for="ChucVu" class="form-control" placeholder="VD: Phục vụ..." />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SDT" class="form-label fw-bold">Số điện thoại</label>
                                <input asp-for="SDT" class="form-control" />
                                <span asp-validation-for="SDT" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-bold">Email</label>
                                <input asp-for="Email" class="form-control" type="email" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="NgaySinh" class="form-label fw-bold">Ngày sinh</label>
                                <input asp-for="NgaySinh" class="form-control" type="date" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Giới tính</label>
                                <div class="d-flex gap-4 mt-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="GioiTinh" value="true" />
                                        <label class="form-check-label">Nam</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="GioiTinh" value="false" />
                                        <label class="form-check-label">Nữ</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold d-block">Trạng thái làm việc</label>
                            <div class="btn-group" role="group">
                                <input type="radio" class="btn-check" asp-for="TrangThaiNV" value="true" id="tt_lam" autocomplete="off">
                                <label class="btn btn-outline-success" for="tt_lam">Đang làm việc</label>

                                <input type="radio" class="btn-check" asp-for="TrangThaiNV" value="false" id="tt_nghi" autocomplete="off">
                                <label class="btn btn-outline-secondary" for="tt_nghi">Đã nghỉ việc</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DiaChi" class="form-label fw-bold">Địa chỉ</label>
                            <textarea asp-for="DiaChi" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: ẢNH & TÀI KHOẢN -->
            <div class="col-lg-4">
                <!-- 1. Ảnh đại diện -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body text-center">
                        <label class="form-label fw-bold mb-3">Ảnh thẻ / Avatar</label>
                        <div class="border rounded-circle p-1 bg-white shadow-sm mb-3 mx-auto position-relative" style="width: 150px; height: 150px; overflow: hidden;">
                            <img id="imagePreview"
                                 src="@(string.IsNullOrEmpty(Model.HinhAnh) ? "/images/avatar-default.png" : Model.HinhAnh)"
                                 class="w-100 h-100" style="object-fit: cover;" />
                        </div>
                        <label for="uploadBox" class="btn btn-sm btn-outline-success w-100">
                            <i class="fa-solid fa-camera me-2"></i> Chọn ảnh mới
                        </label>
                        <input type="file" name="file" id="uploadBox" class="d-none" accept="image/*" onchange="previewImage(this)" />
                    </div>
                </div>

                <!-- 2. Quản lý Tài khoản (Chỉ hiện nếu HasAccount = true) -->
                @if (Model.HasAccount)
                {
                    <div class="card border-0 shadow-sm rounded-4 bg-light">
                        <div class="card-header bg-warning bg-opacity-10 border-0 py-3">
                            <h5 class="fw-bold text-warning text-dark mb-0">Quản trị tài khoản</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label text-muted small">Tên đăng nhập</label>
                                <input asp-for="TenTK" class="form-control fw-bold" readonly style="background: #e9ecef;" />
                            </div>

                            <div class="mb-3">
                                <label asp-for="VaiTro" class="form-label fw-bold">Phân quyền</label>
                                <select asp-for="VaiTro" class="form-select" asp-items="ViewBag.ListRole"></select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Trạng thái truy cập</label>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="TrangThaiTK" id="switchLock">
                                    <label class="form-check-label" for="switchLock">
                                        @(Model.TrangThaiTK == true ? "Đang hoạt động (Mở)" : "Đang bị khóa (Chặn)")
                                    </label>
                                </div>
                            </div>

                            <hr />

                            <div class="mb-2">
                                <label asp-for="NewPassword" class="form-label fw-bold text-danger">Đặt lại mật khẩu mới</label>
                                <input asp-for="NewPassword" class="form-control" type="password" placeholder="Chỉ nhập nếu muốn đổi..." />
                                <small class="text-muted fst-italic">Để trống nếu không muốn thay đổi.</small>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning rounded-4 border-0 shadow-sm">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i> Nhân viên này chưa có tài khoản truy cập hệ thống.
                    </div>
                }
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 mt-4 pt-4 border-top">
            <a asp-action="Index" class="btn btn-light px-4">Hủy bỏ</a>
            <button type="submit" class="btn btn-success px-5 fw-bold">
                <i class="fa-solid fa-floppy-disk me-2"></i> Lưu thay đổi
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("~/Views/Shared/_ValidationScriptsPartial.cshtml");
    }
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) { $('#imagePreview').attr('src', e.target.result); }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}