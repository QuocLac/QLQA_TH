@model QLQA_TH.Models.KhuyenMai

<form asp-action="Upsert" method="post" id="upsertForm">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" style="font-size:0.9rem"></div>

    @if (Model.MaKM != 0)
    {
        <input type="hidden" asp-for="MaKM" />
    }

    <div class="row">
        <!-- Cột trái: Thông tin chung -->
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="TenKM" class="form-label fw-bold">Tên chương trình</label>
                <input asp-for="TenKM" class="form-control" placeholder="VD: Mừng khai trương..." />
                <span asp-validation-for="TenKM" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MaVoucher" class="form-label fw-bold">Mã Voucher (Code)</label>
                <input asp-for="MaVoucher" class="form-control text-uppercase font-monospace" placeholder="VD: SUMMER2025" />
                <span asp-validation-for="MaVoucher" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="SoLuong" class="form-label fw-bold">Số lượng</label>
                    <input asp-for="SoLuong" class="form-control" type="number" />
                    <span asp-validation-for="SoLuong" class="text-danger small"></span>
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="DieuKienApDung" class="form-label fw-bold">Đơn tối thiểu</label>
                    <input asp-for="DieuKienApDung" class="form-control" type="number" placeholder="0 đ" />
                    <span asp-validation-for="DieuKienApDung" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <!-- Cột phải: Giá trị & Thời gian -->
        <div class="col-md-6 border-start ps-4">
            <h6 class="text-success fw-bold mb-3">Giá trị giảm giá (Chọn 1 trong 2)</h6>

            <div class="mb-3">
                <label asp-for="PhanTramGiam" class="form-label">Giảm theo %</label>
                <div class="input-group">
                    <input asp-for="PhanTramGiam" class="form-control" type="number" max="100" placeholder="0" />
                    <span class="input-group-text">%</span>
                </div>
                <span asp-validation-for="PhanTramGiam" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SoTienGiam" class="form-label">Hoặc giảm tiền trực tiếp</label>
                <div class="input-group">
                    <input asp-for="SoTienGiam" class="form-control" type="number" placeholder="0" />
                    <span class="input-group-text">VNĐ</span>
                </div>
                <span asp-validation-for="SoTienGiam" class="text-danger small"></span>
            </div>

            <hr />

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="NgayBatDau" class="form-label fw-bold">Bắt đầu</label>
                    <input asp-for="NgayBatDau" class="form-control" type="date" />
                    <span asp-validation-for="NgayBatDau" class="text-danger small"></span>
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="NgayKetThuc" class="form-label fw-bold">Kết thúc</label>
                    <input asp-for="NgayKetThuc" class="form-control" type="date" />
                    <span asp-validation-for="NgayKetThuc" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3 pt-3 border-top">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
        <button type="submit" class="btn btn-primary px-4 fw-bold">Lưu Chương Trình</button>
    </div>
</form>

@{
    await Html.RenderPartialAsync("~/Views/Shared/_ValidationScriptsPartial.cshtml");
}