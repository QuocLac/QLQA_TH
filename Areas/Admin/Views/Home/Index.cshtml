@model QLQA_TH.Areas.Admin.Models.DashboardViewModel

@{
    ViewData["Title"] = "Tổng quan";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="content-body">
    <h3 class="mb-4 fw-bold">Tổng quan kinh doanh</h3>

    <!-- 1. Thẻ thống kê (Sử dụng Model thực) -->
    <section class="stats-grid">
        <div class="stat-card">
            <div class="stat-card-info">
                <p class="stat-card-title">Doanh thu</p>
                <p class="stat-card-value">@Model.TotalRevenue.ToString("N0") ₫</p>
            </div>
            <div class="stat-card-icon icon-revenue">
                <i class="fa-solid fa-sack-dollar"></i>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-card-info">
                <p class="stat-card-title">Món ăn</p>
                <p class="stat-card-value">@Model.ProductCount</p>
            </div>
            <div class="stat-card-icon icon-products">
                <i class="fa-solid fa-burger"></i>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-card-info">
                <p class="stat-card-title">Nhân sự</p>
                <p class="stat-card-value">@Model.UserCount</p>
            </div>
            <div class="stat-card-icon icon-users">
                <i class="fa-solid fa-user-group"></i>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-card-info">
                <p class="stat-card-title">Đơn hàng</p>
                <p class="stat-card-value">@Model.OrderCount</p>
            </div>
            <div class="stat-card-icon icon-orders">
                <i class="fa-solid fa-receipt"></i>
            </div>
        </div>
    </section>

    <!-- 2. Biểu đồ Tăng trưởng (Canvas Chart.js) -->
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-header bg-white border-bottom-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Biểu đồ doanh thu (7 ngày qua)</h5>
        </div>
        <div class="card-body">
            <div style="height: 350px;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>

    <!-- 3. Bảng Sản phẩm bán chạy -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold">Top 5 Món ăn bán chạy nhất</h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Tên món</th>
                            <th>Đã bán</th>
                            <th>Giá bán</th>
                            <th>Tồn kho</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.TopSellingProducts)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        <!-- Ảnh đại diện -->
                                        <div style="width: 40px; height: 40px; border-radius: 6px; overflow: hidden; margin-right: 12px; background: #f8f9fa;">
                                            <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/placeholder.png" : product.ImageUrl)"
                                                 alt="@product.ProductName"
                                                 style="width: 100%; height: 100%; object-fit: cover;">
                                        </div>
                                        <span class="fw-medium">@product.ProductName</span>
                                    </div>
                                </td>
                                <td>@product.QuantitySold</td>
                                <td>@product.Price.ToString("N0") ₫</td>
                                <td>@product.Stock</td>
                                <td>
                                    @if (product.Stock > 20)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 rounded-pill">Còn hàng</span>
                                    }
                                    else if (product.Stock > 0)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning px-3 rounded-pill">Sắp hết</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-3 rounded-pill">Hết hàng</span>
                                    }
                                </td>
                            </tr>
                        }

                        @if (!Model.TopSellingProducts.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-3">Chưa có dữ liệu bán hàng.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Lấy context của canvas
        var ctx = document.getElementById('revenueChart').getContext('2d');

        // Dữ liệu từ Controller truyền sang (Serialize thành JSON)
        var chartLabels = @Html.Raw(Json.Serialize(Model.ChartLabels));
        var chartData = @Html.Raw(Json.Serialize(Model.ChartValues));

        // Cấu hình Chart
        var revenueChart = new Chart(ctx, {
            type: 'line', // Loại biểu đồ đường
            data: {
                labels: chartLabels,
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: chartData,
                    backgroundColor: 'rgba(46, 125, 50, 0.2)', // Màu nền vùng dưới đường (Xanh lá nhạt)
                    borderColor: 'rgba(46, 125, 50, 1)',       // Màu đường kẻ (Xanh lá đậm)
                    borderWidth: 2,
                    pointBackgroundColor: '#fff',
                    pointBorderColor: '#2E7D32',
                    pointRadius: 5,
                    pointHoverRadius: 7,
                    fill: true, // Tô màu vùng dưới
                    tension: 0.4 // Độ cong mềm mại của đường (0 = thẳng tắp)
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false // Ẩn chú thích nếu chỉ có 1 dòng
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let label = context.dataset.label || '';
                                if (label) {
                                    label += ': ';
                                }
                                if (context.parsed.y !== null) {
                                    // Format tiền Việt
                                    label += new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.parsed.y);
                                }
                                return label;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            // Format trục Y thành tiền
                            callback: function(value) {
                                return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND', maximumSignificantDigits: 3 }).format(value);
                            }
                        }
                    }
                }
            }
        });
    </script>
}