@model QLQA_TH.Models.MonAn

@{
    ViewData["Title"] = "Thêm Món Mới";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center my-4">
        <div>
            <h2 class="fw-bold text-success">Thêm Món Ăn Mới</h2>
            <p class="text-muted mb-0">Nhập thông tin món ăn vào hệ thống.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i> Quay lại
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-5">
            <!-- Form trỏ về Action Create -->
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-4">
                            <label asp-for="TenMon" class="form-label fw-bold">Tên Món Ăn</label>
                            <input asp-for="TenMon" class="form-control form-control-lg" placeholder="Nhập tên món..." />
                            <span asp-validation-for="TenMon" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Gia" class="form-label fw-bold">Giá bán (VNĐ)</label>
                                <input asp-for="Gia" class="form-control" type="number" min="0" />
                                <span asp-validation-for="Gia" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="SoLuong" class="form-label fw-bold">Số lượng tồn kho</label>
                                <input asp-for="SoLuong" class="form-control" type="number" min="0" value="100" />
                                <span asp-validation-for="SoLuong" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="MaLoai" class="form-label fw-bold">Danh Mục</label>
                            <select asp-for="MaLoai" class="form-select" asp-items="ViewBag.ListLoai">
                                <option disabled selected>-- Chọn danh mục --</option>
                            </select>
                            <span asp-validation-for="MaLoai" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="MoTa" class="form-label fw-bold">Mô tả</label>
                            <textarea asp-for="MoTa" class="form-control" rows="5"></textarea>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card border-0 bg-light h-100">
                            <div class="card-body text-center d-flex flex-column justify-content-center align-items-center">
                                <label class="form-label fw-bold mb-3">Hình ảnh</label>
                                <div class="border rounded-3 p-1 bg-white shadow-sm mb-3 position-relative" style="width: 100%; height: 300px;">
                                    <img id="imagePreview" src="/images/placeholder.png"
                                         class="position-absolute top-0 start-0 w-100 h-100 rounded-3" style="object-fit: cover;" />
                                </div>
                                <label for="uploadBox" class="btn btn-outline-success w-100">
                                    <i class="fa-solid fa-cloud-arrow-up me-2"></i> Chọn ảnh
                                </label>
                                <input type="file" name="file" id="uploadBox" class="d-none" accept="image/*" onchange="previewImage(this)" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-4 pt-4 border-top">
                    <a asp-action="Index" class="btn btn-light px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-success px-5 fw-bold">
                        <i class="fa-solid fa-plus me-2"></i> Thêm Món
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("~/Views/Shared/_ValidationScriptsPartial.cshtml");
    }
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) { $('#imagePreview').attr('src', e.target.result); }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}