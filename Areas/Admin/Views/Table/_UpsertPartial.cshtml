@model QLQA_TH.Models.Ban

<form asp-action="Upsert" method="post" id="upsertForm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <!-- Nếu MaBan != 0 thì là Edit, cần input hidden -->
    @if (Model.MaBan != 0)
    {
        <input type="hidden" asp-for="MaBan" />
    }

    <div class="mb-3">
        <label asp-for="TenBan" class="form-label fw-bold">Tên Bàn</label>
        <input asp-for="TenBan" class="form-control" placeholder="Ví dụ: Bàn 01,..." required />
        <span asp-validation-for="TenBan" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SoGhe" class="form-label fw-bold">Số Ghế</label>
        <input asp-for="SoGhe" class="form-control" type="number" min="1" required />
        <span asp-validation-for="SoGhe" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TrangThai" class="form-label fw-bold">Trạng Thái</label>
        <select asp-for="TrangThai" class="form-select">
            <option value="0">Trống</option>
            <option value="1">Có khách</option>
            <option value="2">Đã đặt</option>
        </select>
        <span asp-validation-for="TrangThai" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
        <button type="submit" class="btn btn-primary px-4">
            @(Model.MaBan != 0 ? "Cập nhật" : "Thêm mới")
        </button>
    </div>
</form>

<!-- Script Validation cho Partial View -->
@{
    await Html.RenderPartialAsync("~/Views/Shared/_ValidationScriptsPartial.cshtml");
}